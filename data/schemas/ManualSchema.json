{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://fixwhat.dev/schemas/ManualSchema.json",
  "title": "FixWhat Manual Procedure Contract",
  "description": "Authoritative, source-grounded data contract for equipment manuals and multi-step maintenance/repair procedures on Snap Spectacles.",
  "type": "object",
  "required": [
    "schemaVersion",
    "manualId",
    "appliance",
    "sourceDocument",
    "procedure"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "type": "string",
      "enum": [
        "1.0.0"
      ]
    },
    "manualId": {
      "type": "string",
      "pattern": "^[a-z0-9_-]+$"
    },
    "appliance": {
      "type": "object",
      "required": [
        "manufacturer",
        "modelFamily",
        "compatibleModels",
        "category"
      ],
      "properties": {
        "manufacturer": {
          "type": "string",
          "minLength": 1
        },
        "modelFamily": {
          "type": "string",
          "minLength": 1
        },
        "compatibleModels": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Z0-9._-]+$"
          },
          "minItems": 1
        },
        "category": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "sourceDocument": {
      "type": "object",
      "required": [
        "title",
        "publisher",
        "documentCode",
        "url",
        "accessDate",
        "verificationStatus"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "publisher": {
          "type": "string",
          "minLength": 1
        },
        "documentCode": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "minLength": 1,
          "pattern": "^https?://.+"
        },
        "accessDate": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "verificationStatus": {
          "type": "string",
          "enum": [
            "VERIFIED_MANUFACTURER_SOURCE",
            "UNVERIFIED_THIRD_PARTY",
            "SYNTHETIC_PROPOSAL"
          ]
        }
      },
      "additionalProperties": false
    },
    "procedure": {
      "type": "object",
      "required": [
        "procedureId",
        "title",
        "taskType",
        "estimatedTimeMinutes",
        "prerequisites",
        "requiredTools",
        "phases",
        "steps",
        "completionCheck"
      ],
      "properties": {
        "procedureId": {
          "type": "string",
          "pattern": "^[a-z0-9_-]+$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "taskType": {
          "type": "string",
          "enum": [
            "DESCALING",
            "MAINTENANCE",
            "REPAIR",
            "CLEANING",
            "ASSEMBLY",
            "SETUP"
          ]
        },
        "estimatedTimeMinutes": {
          "type": "integer",
          "minimum": 1
        },
        "prerequisites": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "requiredTools": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "toolId",
              "name",
              "specification",
              "isConsumable"
            ],
            "properties": {
              "toolId": {
                "type": "string",
                "pattern": "^[a-z0-9_-]+$"
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "specification": {
                "type": "string",
                "minLength": 1
              },
              "isConsumable": {
                "type": "boolean"
              }
            },
            "additionalProperties": false
          }
        },
        "phases": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "phaseIndex",
              "title",
              "description"
            ],
            "properties": {
              "phaseIndex": {
                "type": "integer",
                "minimum": 0
              },
              "title": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          }
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "stepId",
              "stepIndex",
              "phaseIndex",
              "title",
              "instructionText",
              "hazardLevel",
              "safetyNotice",
              "isBlockingSafetyBarrier",
              "sourceCitation",
              "trainingExplanation"
            ],
            "properties": {
              "stepId": {
                "type": "string",
                "pattern": "^[a-z0-9_-]+$"
              },
              "stepIndex": {
                "type": "integer",
                "minimum": 0
              },
              "phaseIndex": {
                "type": "integer",
                "minimum": 0
              },
              "title": {
                "type": "string",
                "minLength": 1
              },
              "instructionText": {
                "type": "string",
                "minLength": 1
              },
              "hazardLevel": {
                "type": "string",
                "enum": [
                  "NONE",
                  "INFO",
                  "CAUTION",
                  "DANGER"
                ]
              },
              "safetyNotice": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "isBlockingSafetyBarrier": {
                "type": "boolean"
              },
              "requiredToolIds": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "modelSpecificBranches": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "appliesToModels",
                    "branchInstruction",
                    "sourceCitation"
                  ],
                  "properties": {
                    "appliesToModels": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1,
                        "pattern": "^[A-Z0-9._-]+$"
                      },
                      "minItems": 1
                    },
                    "branchInstruction": {
                      "type": "string",
                      "minLength": 1
                    },
                    "sourceCitation": {
                      "type": "object",
                      "required": [
                        "sectionHeading",
                        "pageNumber",
                        "exactExcerpt"
                      ],
                      "properties": {
                        "sectionHeading": {
                          "type": "string",
                          "minLength": 1
                        },
                        "pageNumber": {
                          "type": "integer",
                          "minimum": 1
                        },
                        "diagramReference": {
                          "type": [
                            "string",
                            "null"
                          ]
                        },
                        "exactExcerpt": {
                          "type": "string",
                          "minLength": 1
                        }
                      },
                      "additionalProperties": false
                    }
                  },
                  "additionalProperties": false
                }
              },
              "sourceCitation": {
                "type": "object",
                "required": [
                  "sectionHeading",
                  "pageNumber",
                  "exactExcerpt"
                ],
                "properties": {
                  "sectionHeading": {
                    "type": "string",
                    "minLength": 1
                  },
                  "pageNumber": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "diagramReference": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "exactExcerpt": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "additionalProperties": false
              },
              "trainingExplanation": {
                "type": "object",
                "required": [
                  "whyItMatters",
                  "componentInvolved",
                  "explanationOrigin"
                ],
                "properties": {
                  "whyItMatters": {
                    "type": "string",
                    "minLength": 1
                  },
                  "componentInvolved": {
                    "type": "string",
                    "minLength": 1
                  },
                  "explanationOrigin": {
                    "type": "string",
                    "enum": [
                      "MANUFACTURER_VERBATIM",
                      "DOMAIN_EXPERT_INFERRED"
                    ]
                  },
                  "knowledgeCheckQuestion": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          }
        },
        "completionCheck": {
          "type": "object",
          "required": [
            "finalCondition",
            "safetyVerificationText"
          ],
          "properties": {
            "finalCondition": {
              "type": "string",
              "minLength": 1
            },
            "safetyVerificationText": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}